{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "variables": {
    "sourceCodeBranch": "master",
    "templateBaseUri": "[concat('https://raw.githubusercontent.com/logicmonitor/lm-logs-azure/',variables('sourceCodeBranch'),'/arm-template-deployment/')]",
    "deploymentResourceGroupName": "[concat('lm-logs-',parameters('LM_Company_name'),'-',resourceGroup().Location,'-group')]",
    "managedIdentityName": "[concat('msi-', variables('deploymentResourceGroupName'), '-deploy')]",
    "managedIdentityId": "[concat('/subscriptions/', subscription().subscriptionId, '/resourceGroups/', variables('deploymentResourceGroupName'), '/providers/Microsoft.ManagedIdentity/userAssignedIdentities/', variables('managedIdentityName'))]"
  },
  "parameters": {
    "subscriptionId": {
      "type": "String"
    },
    "LM_Company_name": {
      "type": "String"
    },
    "forceUpdateTag": {
      "defaultValue": "[utcNow()]",
      "type": "String",
      "metadata": "Please do not edit this setting"
    },
    "deploymentLocation": {
      "type": "string",
      "allowedValues": [
        "Australia East","Australia Southeast","Brazil South","Canada Central","Canada East","Central India","Central US","East Asia","East US","East US 2","France Central","Germany West Central","Japan East","Japan West","Korea Central","North Central US","North Europe","Norway East","South Central US","Southeast Asia","South India","Switzerland North","UK South","UK West","UAE North","West Central US","West Europe","West US","West US 2"
      ],
      "metadata": {
        "description": "region for deployment script"
      },
      "defaultValue": "West US"
    },
    "Event_Hub_Name": {
      "type": "string",
      "defaultValue": "log-hub",
      "metadata": {
        "description": "Same as deployRGParent Event_Hub_Name. Resource diagnostic settings send to this hub. Re-run this template after changing Event Hub on the main LM logs deploy."
      }
    },
    "Existing_Event_Hub_Resource_Group": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Reuse only: resource group of the Event Hub namespace. Leave empty for LM-created namespace."
      }
    },
    "Existing_Event_Hub_Namespace": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Reuse only: Event Hub namespace name. Leave empty for LM-created namespace."
      }
    },
    "Existing_Event_Hub_Send_Authorization_Rule": {
      "type": "string",
      "defaultValue": "RootManageSharedAccessKey",
      "metadata": {
        "description": "Namespace Send rule for diagnostic settings. Create mode: RootManageSharedAccessKey. Reuse: your namespace Send rule."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2017-05-10",
      "name": "[resourceGroup().name]",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(variables('templateBaseUri'), 'deploymentChildScript.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "resourceGroup": {
            "value": "[resourceGroup().name]"
          },
          "LM_Company_name": {
            "value": "[parameters('LM_Company_name')]"
          },
          "subscriptionId": {
            "value": "[parameters('subscriptionId')]"
          },
          "managedIdentity": {
            "value": "[variables('managedIdentityId')]"
          },
          "utcNow": {
            "value": "[parameters('forceUpdateTag')]"
          },
          "location": {
            "value": "[resourceGroup().Location]"
          },
          "sourceCodeBranch": {
            "value": "[variables('sourceCodeBranch')]"
          },
          "deploymentLocation": {
            "value": "[parameters('deploymentLocation')]"
          },
          "Event_Hub_Name": {
            "value": "[parameters('Event_Hub_Name')]"
          },
          "Existing_Event_Hub_Resource_Group": {
            "value": "[parameters('Existing_Event_Hub_Resource_Group')]"
          },
          "Existing_Event_Hub_Namespace": {
            "value": "[parameters('Existing_Event_Hub_Namespace')]"
          },
          "Existing_Event_Hub_Send_Authorization_Rule": {
            "value": "[parameters('Existing_Event_Hub_Send_Authorization_Rule')]"
          }
        }
      },
      "resourceGroup": "[variables('deploymentResourceGroupName')]"
    }
  ]
}