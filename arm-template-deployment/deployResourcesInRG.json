{
  "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "LM_Company_Name": {
      "type": "string"
    },
    "LM_Access_Id": {
      "type": "string"
    },
    "LM_Access_Key": {
      "type": "string"
    },
    "LM_Bearer_Token": {
      "type": "string"
    },
    "Azure_Client_Id": {
      "type": "string"
    },
    "Azure_Account_Name": {
      "type": "string"
    },
    "Include_Metadata_keys": {
      "type": "string"
    },
    "LM_Tenant_Id": {
      "type": "string"
    },
    "Azure_Region": {
      "type": "string"
    },
    "sourceCodeBranch": {
      "type": "string"
    },
    "LM_Domain_Name": {
      "type": "string"
    },
    "TLSVersionStorageAccount": {
      "type": "string"
    },
    "TLSVersionFunctionApp": {
      "type": "string"
    },
    "Use_Custom_Storage_Account_Name": {
      "type": "string",
      "defaultValue": "No",
      "allowedValues": [
        "Yes",
        "No"
      ],
      "metadata": {
        "description": "Yes = create a new storage account named StorageAccountName in the LM logs resource group. No = use the generated name. Ignored when Use_Existing_Storage_Account=Yes."
      }
    },
    "Use_Existing_Storage_Account": {
      "type": "string",
      "defaultValue": "No",
      "allowedValues": [
        "Yes",
        "No"
      ],
      "metadata": {
        "description": "Yes = use the storage account named StorageAccountName in Existing_Storage_Account_Resource_Group. No = create a storage account in the LM logs resource group."
      }
    },
    "StorageAccountName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Set this when using an existing storage account or a custom name. Use_Existing_Storage_Account=Yes: exact name of the account in Existing_Storage_Account_Resource_Group. If that name is not in that resource group, the deployment fails. Use_Custom_Storage_Account_Name=Yes: name of the new account created in the LM logs resource group. Ignored when both are No. Example: acmeeastus (company acme, region eastus). 3-24 characters, lowercase letters and numbers only."
      }
    },
    "Existing_Storage_Account_Resource_Group": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Required when Use_Existing_Storage_Account=Yes. Resource group of the existing storage account. Same subscription as this deployment."
      }
    },
    "Use_Custom_Function_App_Name": {
      "type": "string",
      "defaultValue": "No",
      "allowedValues": [
        "Yes",
        "No"
      ],
      "metadata": {
        "description": "Yes = create a new Function App named FunctionAppName in the LM logs resource group. No = use the generated name. Ignored when Use_Existing_Function_App=Yes."
      }
    },
    "Use_Existing_Function_App": {
      "type": "string",
      "defaultValue": "No",
      "allowedValues": [
        "Yes",
        "No"
      ],
      "metadata": {
        "description": "Yes = use the Function App named FunctionAppName in Existing_Function_App_Resource_Group. The deployment replaces that Function App's application settings with the LM Logs settings. No = create a Function App in the LM logs resource group."
      }
    },
    "FunctionAppName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Set this when using an existing Function App or a custom name. Use_Existing_Function_App=Yes: exact name of the Function App in Existing_Function_App_Resource_Group. If that name is not a Function App in that resource group, the deployment fails. Use_Custom_Function_App_Name=Yes: name of the new Function App created in the LM logs resource group. Ignored when both are No. Example: lm-logs-acme-eastus (company acme, region eastus). 2-60 characters; letters, numbers, and hyphens; cannot start or end with a hyphen."
      }
    },
    "Existing_Function_App_Resource_Group": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Required when Use_Existing_Function_App=Yes. Resource group of the existing Function App. Same subscription as this deployment."
      }
    },
    "Use_Existing_Event_Hub": {
      "type": "string",
      "defaultValue": "No",
      "allowedValues": [
        "Yes",
        "No"
      ],
      "metadata": {
        "description": "Yes = reuse an existing Event Hub (do not create namespace/hub/CG). No = create them in this deployment."
      }
    },
    "Event_Hub_Name": {
      "type": "string",
      "defaultValue": "log-hub",
      "metadata": {
        "description": "Event Hub name. Created when Use_Existing_Event_Hub=No; must already exist when Yes."
      }
    },
    "Event_Hub_Consumer_Group": {
      "type": "string",
      "defaultValue": "$Default",
      "metadata": {
        "description": "Consumer group for LogForwarder. Created when Use_Existing_Event_Hub=No and not $Default; must already exist when Yes."
      }
    },
    "Existing_Event_Hub_Resource_Group": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Required when Use_Existing_Event_Hub=Yes. Resource group of the existing Event Hub namespace."
      }
    },
    "Existing_Event_Hub_Namespace": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Required when Use_Existing_Event_Hub=Yes. Existing Event Hub namespace name."
      }
    },
    "Existing_Event_Hub_Authorization_Rule": {
      "type": "string",
      "defaultValue": "listener",
      "metadata": {
        "description": "Listen-only authorization rule for LogsEventHubConnectionString. Prefer hub-level listener (default). Avoid RootManageSharedAccessKey."
      }
    },
    "Existing_Event_Hub_Auth_Rule_Scope": {
      "type": "string",
      "defaultValue": "EventHub",
      "allowedValues": [
        "Namespace",
        "EventHub"
      ],
      "metadata": {
        "description": "Whether Existing_Event_Hub_Authorization_Rule is a namespace-level or event-hub-level rule. Default EventHub matches a typical listener rule."
      }
    }
  },
  "variables": {
    "logsFunctionAppName": "[concat('lm-logs','-',parameters('LM_Company_Name'), '-', replace(parameters('Azure_Region'),' ',''))]",
    "createdEventHubNamespace": "[concat('lm-logs','-',parameters('LM_Company_Name'), '-', replace(parameters('Azure_Region'),' ',''))]",
    "storage": "[toLower(concat(parameters('LM_Company_Name'), replace(parameters('Azure_Region'),' ','')))]",
    "lmAppStorageAccounts": "[if(greater(length(variables('storage')) , 24), substring(variables('storage'), sub(length(variables('storage')) , 24), 24) , variables('storage'))]",
    "eventhubLogsName": "[parameters('Event_Hub_Name')]",
    "ConsumergroupsLogsName": "[parameters('Event_Hub_Consumer_Group')]",
    "functionServerfarms": "[concat(variables('createdEventHubNamespace'),'-service-plan')]",
    "listener": "listener",
    "sender": "sender",
    "lm_auth": "[concat('{ \"LM_ACCESS_ID\" : \"',parameters('LM_Access_Id'),'\", \"LM_ACCESS_KEY\" : \"', parameters('LM_Access_Key'), '\", \"LM_BEARER_TOKEN\" : \"', parameters('LM_Bearer_Token'), '\" }')]",
    "tlsVersionStorageAccount": "[concat('TLS',parameters('TLSVersionStorageAccount'))]",
    "useExistingEventHub": "[equals(parameters('Use_Existing_Event_Hub'), 'Yes')]",
    "createEventHubResources": "[not(variables('useExistingEventHub'))]",
    "createCustomConsumerGroup": "[and(variables('createEventHubResources'), not(equals(parameters('Event_Hub_Consumer_Group'), '$Default')))]",
    "existingHubFullyConfigured": "[and(not(empty(parameters('Existing_Event_Hub_Resource_Group'))), not(empty(parameters('Existing_Event_Hub_Namespace'))), not(empty(parameters('Event_Hub_Name'))), not(empty(parameters('Existing_Event_Hub_Authorization_Rule'))))]",
    "eventHubResourceGroup": "[if(variables('useExistingEventHub'), parameters('Existing_Event_Hub_Resource_Group'), resourceGroup().name)]",
    "eventHubNamespaceName": "[if(variables('useExistingEventHub'), parameters('Existing_Event_Hub_Namespace'), variables('createdEventHubNamespace'))]",
    "safeExistingRg": "[if(empty(parameters('Existing_Event_Hub_Resource_Group')), 'missing-existing-eventhub-rg', parameters('Existing_Event_Hub_Resource_Group'))]",
    "safeExistingNamespace": "[if(empty(parameters('Existing_Event_Hub_Namespace')), 'missing-existing-eventhub-namespace', parameters('Existing_Event_Hub_Namespace'))]",
    "safeExistingHub": "[if(empty(parameters('Event_Hub_Name')), 'missing-eventhub-name', parameters('Event_Hub_Name'))]",
    "safeExistingRule": "[if(empty(parameters('Existing_Event_Hub_Authorization_Rule')), 'missing-auth-rule', parameters('Existing_Event_Hub_Authorization_Rule'))]",
    "existingNamespaceAuthRuleId": "[resourceId(variables('safeExistingRg'), 'Microsoft.EventHub/namespaces/authorizationRules', variables('safeExistingNamespace'), variables('safeExistingRule'))]",
    "existingEventHubAuthRuleId": "[resourceId(variables('safeExistingRg'), 'Microsoft.EventHub/namespaces/eventhubs/authorizationRules', variables('safeExistingNamespace'), variables('safeExistingHub'), variables('safeExistingRule'))]",
    "existingAuthRuleId": "[if(equals(parameters('Existing_Event_Hub_Auth_Rule_Scope'), 'EventHub'), variables('existingEventHubAuthRuleId'), variables('existingNamespaceAuthRuleId'))]",
    "createdListenerAuthRuleId": "[resourceId('Microsoft.EventHub/namespaces/eventhubs/authorizationRules', variables('createdEventHubNamespace'), variables('eventhubLogsName'), variables('listener'))]",
    "activeAuthRuleId": "[if(variables('useExistingEventHub'), variables('existingAuthRuleId'), variables('createdListenerAuthRuleId'))]",
    "useCustomStorageAccountName": "[equals(parameters('Use_Custom_Storage_Account_Name'), 'Yes')]",
    "useCustomFunctionAppName": "[equals(parameters('Use_Custom_Function_App_Name'), 'Yes')]",
    "useExistingStorageAccount": "[equals(parameters('Use_Existing_Storage_Account'), 'Yes')]",
    "useExistingFunctionApp": "[equals(parameters('Use_Existing_Function_App'), 'Yes')]",
    "customStorageAccountNameConfigured": "[not(empty(parameters('StorageAccountName')))]",
    "customFunctionAppNameConfigured": "[not(empty(parameters('FunctionAppName')))]",
    "existingStorageFullyConfigured": "[and(not(empty(parameters('StorageAccountName'))), not(empty(parameters('Existing_Storage_Account_Resource_Group'))))]",
    "existingFunctionFullyConfigured": "[and(not(empty(parameters('FunctionAppName'))), not(empty(parameters('Existing_Function_App_Resource_Group'))))]",
    "generatedStorageAccountName": "[if(empty(variables('lmAppStorageAccounts')), 'lmlogstorageacct', variables('lmAppStorageAccounts'))]",
    "generatedFunctionAppName": "[if(empty(variables('logsFunctionAppName')), 'lm-logs-function', variables('logsFunctionAppName'))]",
    "providedStorageAccountName": "[if(empty(parameters('StorageAccountName')), variables('generatedStorageAccountName'), parameters('StorageAccountName'))]",
    "providedFunctionAppName": "[if(empty(parameters('FunctionAppName')), variables('generatedFunctionAppName'), parameters('FunctionAppName'))]",
    "effectiveLmAppStorageAccounts": "[if(and(or(variables('useExistingStorageAccount'), variables('useCustomStorageAccountName')), variables('customStorageAccountNameConfigured')), variables('providedStorageAccountName'), variables('generatedStorageAccountName'))]",
    "effectiveLogsFunctionAppName": "[if(and(or(variables('useExistingFunctionApp'), variables('useCustomFunctionAppName')), variables('customFunctionAppNameConfigured')), variables('providedFunctionAppName'), variables('generatedFunctionAppName'))]",
    "storageAccountResourceGroup": "[if(variables('useExistingStorageAccount'), parameters('Existing_Storage_Account_Resource_Group'), resourceGroup().name)]",
    "functionAppResourceGroup": "[if(variables('useExistingFunctionApp'), parameters('Existing_Function_App_Resource_Group'), resourceGroup().name)]",
    "createStorageAccount": "[not(variables('useExistingStorageAccount'))]",
    "createFunctionApp": "[not(variables('useExistingFunctionApp'))]"
  },
  "resources": [
    {
      "condition": "[and(variables('useCustomStorageAccountName'), not(variables('customStorageAccountNameConfigured')))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "validate-custom-storage-account-name",
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "variables": {
            "configError": "Use_Custom_Storage_Account_Name=Yes requires StorageAccountName."
          },
          "resources": [],
          "outputs": {
            "parameterCheck": {
              "type": "string",
              "value": "[int(variables('configError'))]"
            }
          }
        }
      }
    },
    {
      "condition": "[and(variables('useCustomFunctionAppName'), not(variables('customFunctionAppNameConfigured')))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "validate-custom-function-app-name",
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "variables": {
            "configError": "Use_Custom_Function_App_Name=Yes requires FunctionAppName."
          },
          "resources": [],
          "outputs": {
            "parameterCheck": {
              "type": "string",
              "value": "[int(variables('configError'))]"
            }
          }
        }
      }
    },
    {
      "condition": "[and(variables('useExistingStorageAccount'), not(variables('existingStorageFullyConfigured')))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "validate-existing-storage-account-params",
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "variables": {
            "configError": "Use_Existing_Storage_Account=Yes requires StorageAccountName and Existing_Storage_Account_Resource_Group."
          },
          "resources": [],
          "outputs": {
            "parameterCheck": {
              "type": "string",
              "value": "[int(variables('configError'))]"
            }
          }
        }
      }
    },
    {
      "condition": "[and(variables('useExistingStorageAccount'), variables('existingStorageFullyConfigured'))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "validate-existing-storage-account",
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "storageResourceGroup": {
            "value": "[parameters('Existing_Storage_Account_Resource_Group')]"
          },
          "storageAccountName": {
            "value": "[parameters('StorageAccountName')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "storageResourceGroup": {
              "type": "string"
            },
            "storageAccountName": {
              "type": "string"
            }
          },
          "variables": {
            "storageAccountId": "[resourceId(parameters('storageResourceGroup'), 'Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
          },
          "resources": [],
          "outputs": {
            "storageAccountExists": {
              "type": "object",
              "value": "[reference(variables('storageAccountId'), '2019-06-01')]"
            }
          }
        }
      }
    },
    {
      "condition": "[and(variables('useExistingFunctionApp'), not(variables('existingFunctionFullyConfigured')))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "validate-existing-function-app-params",
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "variables": {
            "configError": "Use_Existing_Function_App=Yes requires FunctionAppName and Existing_Function_App_Resource_Group."
          },
          "resources": [],
          "outputs": {
            "parameterCheck": {
              "type": "string",
              "value": "[int(variables('configError'))]"
            }
          }
        }
      }
    },
    {
      "condition": "[and(variables('useExistingFunctionApp'), variables('existingFunctionFullyConfigured'))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "validate-existing-function-app",
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "functionResourceGroup": {
            "value": "[parameters('Existing_Function_App_Resource_Group')]"
          },
          "functionAppName": {
            "value": "[parameters('FunctionAppName')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "functionResourceGroup": {
              "type": "string"
            },
            "functionAppName": {
              "type": "string"
            }
          },
          "variables": {
            "functionAppId": "[resourceId(parameters('functionResourceGroup'), 'Microsoft.Web/sites', parameters('functionAppName'))]"
          },
          "resources": [],
          "outputs": {
            "functionAppExists": {
              "type": "object",
              "value": "[reference(variables('functionAppId'), '2020-06-01', 'Full')]"
            },
            "functionAppKind": {
              "type": "string",
              "value": "[if(contains(toLower(string(reference(variables('functionAppId'), '2020-06-01', 'Full').kind)), 'functionapp'), 'ok', int('Use_Existing_Function_App=Yes requires an existing Function App at FunctionAppName in Existing_Function_App_Resource_Group.'))]"
            }
          }
        }
      }
    },
    {
      "condition": "[and(variables('useExistingEventHub'), not(variables('existingHubFullyConfigured')))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "validate-existing-event-hub-params",
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "variables": {
            "configError": "Use_Existing_Event_Hub=Yes requires Existing_Event_Hub_Resource_Group, Existing_Event_Hub_Namespace, Event_Hub_Name, and Existing_Event_Hub_Authorization_Rule."
          },
          "resources": [],
          "outputs": {
            "parameterCheck": {
              "type": "string",
              "value": "[int(variables('configError'))]"
            }
          }
        }
      }
    },
    {
      "condition": "[and(variables('useExistingEventHub'), variables('existingHubFullyConfigured'))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "validate-existing-event-hub",
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "existingResourceGroup": {
            "value": "[parameters('Existing_Event_Hub_Resource_Group')]"
          },
          "existingNamespace": {
            "value": "[parameters('Existing_Event_Hub_Namespace')]"
          },
          "eventHubName": {
            "value": "[parameters('Event_Hub_Name')]"
          },
          "consumerGroup": {
            "value": "[parameters('Event_Hub_Consumer_Group')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "existingResourceGroup": {
              "type": "string"
            },
            "existingNamespace": {
              "type": "string"
            },
            "eventHubName": {
              "type": "string"
            },
            "consumerGroup": {
              "type": "string"
            }
          },
          "variables": {
            "namespaceId": "[resourceId(parameters('existingResourceGroup'), 'Microsoft.EventHub/namespaces', parameters('existingNamespace'))]",
            "hubId": "[resourceId(parameters('existingResourceGroup'), 'Microsoft.EventHub/namespaces/eventhubs', parameters('existingNamespace'), parameters('eventHubName'))]",
            "consumerGroupId": "[resourceId(parameters('existingResourceGroup'), 'Microsoft.EventHub/namespaces/eventhubs/consumergroups', parameters('existingNamespace'), parameters('eventHubName'), parameters('consumerGroup'))]"
          },
          "resources": [],
          "outputs": {
            "namespaceExists": {
              "type": "object",
              "value": "[reference(variables('namespaceId'), '2021-11-01')]"
            },
            "eventHubExists": {
              "type": "object",
              "value": "[reference(variables('hubId'), '2021-11-01')]"
            },
            "consumerGroupExists": {
              "type": "object",
              "value": "[reference(variables('consumerGroupId'), '2021-11-01')]"
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "resolve-eventhub-connection",
      "dependsOn": [
        "validate-existing-event-hub-params",
        "validate-existing-event-hub",
        "[resourceId('Microsoft.EventHub/namespaces/eventhubs/authorizationRules', variables('createdEventHubNamespace'), variables('eventhubLogsName'), variables('listener'))]"
      ],
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "authRuleId": {
            "value": "[variables('activeAuthRuleId')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "authRuleId": {
              "type": "string"
            }
          },
          "resources": [],
          "outputs": {
            "connectionString": {
              "type": "string",
              "value": "[listKeys(parameters('authRuleId'), '2021-11-01').primaryConnectionString]"
            }
          }
        }
      }
    },
    {
      "condition": "[variables('createEventHubResources')]",
      "type": "Microsoft.EventHub/namespaces",
      "sku": {
        "name": "Standard",
        "tier": "Standard",
        "capacity": 1
      },
      "name": "[variables('createdEventHubNamespace')]",
      "apiVersion": "2018-01-01-preview",
      "location": "[resourceGroup().location]",
      "tags": {},
      "properties": {
        "minimumTlsVersion": "1.2"
      },
      "dependsOn": []
    },
    {
      "condition": "[variables('createStorageAccount')]",
      "type": "Microsoft.Storage/storageAccounts",
      "sku": {
        "name": "Standard_LRS",
        "tier": "Standard"
      },
      "kind": "StorageV2",
      "name": "[variables('effectiveLmAppStorageAccounts')]",
      "apiVersion": "2019-06-01",
      "location": "[resourceGroup().location]",
      "properties": {
        "minimumTlsVersion": "[variables('tlsVersionStorageAccount')]",
        "encryption": {
          "services": {
            "file": {
              "enabled": true
            },
            "blob": {
              "enabled": true
            }
          },
          "keySource": "Microsoft.Storage"
        }
      },
      "dependsOn": [
        "validate-custom-storage-account-name",
        "validate-existing-storage-account-params"
      ]
    },
    {
      "condition": "[variables('createFunctionApp')]",
      "type": "Microsoft.Web/serverfarms",
      "sku": {
        "name": "S1",
        "tier": "Standard",
        "size": "S1",
        "family": "S",
        "capacity": 1
      },
      "kind": "Linux",
      "name": "[variables('functionServerfarms')]",
      "apiVersion": "2020-06-01",
      "location": "[resourceGroup().location]",
      "properties": {
        "reserved": true
      },
      "dependsOn": []
    },
    {
      "condition": "[variables('createFunctionApp')]",
      "type": "Microsoft.Web/sites",
      "kind": "functionapp,linux",
      "name": "[variables('effectiveLogsFunctionAppName')]",
      "apiVersion": "2020-06-01",
      "location": "[resourceGroup().location]",
      "properties": {
        "enabled": true,
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('functionServerfarms'))]",
        "reserved": true,
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "Java|11",
          "use32BitWorkerProcess": false,
          "alwaysOn": true,
          "javaVersion": "11",
          "cors": {
            "allowedOrigins": [
              "*"
            ]
          },
          "appSettings": [
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "java"
            },
            {
              "name": "FUNCTIONS_WORKER_PROCESS_COUNT",
              "value": "1"
            },
            {
              "name": "FUNCTION_APP_EDIT_MODE",
              "value": "readwrite"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "[concat('https://github.com/logicmonitor/lm-logs-azure/raw/',parameters('sourceCodeBranch'),'/package/lm-logs-azure-1.0.zip')]"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('effectiveLmAppStorageAccounts'), ';AccountKey=', listKeys(resourceId(variables('storageAccountResourceGroup'), 'Microsoft.Storage/storageAccounts', variables('effectiveLmAppStorageAccounts')),'2019-06-01').keys[0].value)]"
            },
            {
              "name": "LogsEventHubConnectionString",
              "value": "[reference('resolve-eventhub-connection').outputs.connectionString.value]"
            },
            {
              "name": "EventHubName",
              "value": "[parameters('Event_Hub_Name')]"
            },
            {
              "name": "EventHubConsumerGroup",
              "value": "[parameters('Event_Hub_Consumer_Group')]"
            },
            {
              "name": "LM_COMPANY",
              "value": "[parameters('LM_Company_Name')]"
            },
            {
              "name": "LM_AUTH",
              "value": "[variables('lm_auth')]"
            },
            {
              "name": "LM_TENANT_ID",
              "value": "[parameters('LM_Tenant_Id')]"
            },
            {
              "name": "AzureClientID",
              "value": "[parameters('Azure_Client_Id')]"
            },
            {
              "name": "AzureAccountName",
              "value": "[parameters('Azure_Account_Name')]"
            },
            {
              "name": "LogApiClientConnectTimeout",
              "value": "10000"
            },
            {
              "name": "LogApiClientReadTimeout",
              "value": "10000"
            },
            {
              "name": "LogApiClientDebugging",
              "value": "false"
            },
            {
              "name": "LogRegexScrub",
              "value": "<regex pattern>"
            },
            {
              "name": "APPLICATION_NAME",
              "value": "lm-logs-azure"
            },
            {
              "name": "Include_Metadata_keys",
              "value": "[parameters('Include_Metadata_keys')]"
            },
            {
              "name": "LOG_LEVEL",
              "value": "WARNING"
            },
            {
              "name": "LM_FAIL_CLOSED_ON_INGEST",
              "value": "false"
            },
            {
              "name": "LM_DOMAIN_NAME",
              "value": "[parameters('LM_Domain_Name')]"
            }
          ],
          "minTlsVersion": "[parameters('TLSVersionFunctionApp')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('functionServerfarms'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('effectiveLmAppStorageAccounts'))]",
        "validate-custom-function-app-name",
        "validate-existing-storage-account",
        "resolve-eventhub-connection",
        "[resourceId('Microsoft.EventHub/namespaces/eventhubs/consumergroups', variables('createdEventHubNamespace'), variables('eventhubLogsName'), variables('ConsumergroupsLogsName'))]"
      ]
    },
    {
      "condition": "[and(variables('useExistingFunctionApp'), variables('existingFunctionFullyConfigured'))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "configure-existing-function-app",
      "resourceGroup": "[parameters('Existing_Function_App_Resource_Group')]",
      "subscriptionId": "[subscription().subscriptionId]",
      "dependsOn": [
        "validate-existing-function-app",
        "validate-existing-storage-account",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('effectiveLmAppStorageAccounts'))]",
        "resolve-eventhub-connection"
      ],
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "functionAppName": {
            "value": "[variables('effectiveLogsFunctionAppName')]"
          },
          "appSettings": {
            "value": {
              "FUNCTIONS_EXTENSION_VERSION": "~4",
              "FUNCTIONS_WORKER_RUNTIME": "java",
              "FUNCTIONS_WORKER_PROCESS_COUNT": "1",
              "FUNCTION_APP_EDIT_MODE": "readwrite",
              "WEBSITE_RUN_FROM_PACKAGE": "[concat('https://github.com/logicmonitor/lm-logs-azure/raw/',parameters('sourceCodeBranch'),'/package/lm-logs-azure-1.0.zip')]",
              "AzureWebJobsStorage": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('effectiveLmAppStorageAccounts'), ';AccountKey=', listKeys(resourceId(variables('storageAccountResourceGroup'), 'Microsoft.Storage/storageAccounts', variables('effectiveLmAppStorageAccounts')),'2019-06-01').keys[0].value)]",
              "LogsEventHubConnectionString": "[reference('resolve-eventhub-connection').outputs.connectionString.value]",
              "EventHubName": "[parameters('Event_Hub_Name')]",
              "EventHubConsumerGroup": "[parameters('Event_Hub_Consumer_Group')]",
              "LM_COMPANY": "[parameters('LM_Company_Name')]",
              "LM_AUTH": "[variables('lm_auth')]",
              "LM_TENANT_ID": "[parameters('LM_Tenant_Id')]",
              "AzureClientID": "[parameters('Azure_Client_Id')]",
              "AzureAccountName": "[parameters('Azure_Account_Name')]",
              "LogApiClientConnectTimeout": "10000",
              "LogApiClientReadTimeout": "10000",
              "LogApiClientDebugging": "false",
              "LogRegexScrub": "<regex pattern>",
              "APPLICATION_NAME": "lm-logs-azure",
              "Include_Metadata_keys": "[parameters('Include_Metadata_keys')]",
              "LOG_LEVEL": "WARNING",
              "LM_FAIL_CLOSED_ON_INGEST": "false",
              "LM_DOMAIN_NAME": "[parameters('LM_Domain_Name')]"
            }
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "functionAppName": {
              "type": "string"
            },
            "appSettings": {
              "type": "object"
            }
          },
          "resources": [
            {
              "type": "Microsoft.Web/sites/config",
              "apiVersion": "2020-06-01",
              "name": "[concat(parameters('functionAppName'), '/appsettings')]",
              "properties": "[parameters('appSettings')]"
            }
          ]
        }
      }
    },
    {
      "condition": "[variables('createEventHubResources')]",
      "type": "Microsoft.EventHub/namespaces/eventhubs",
      "name": "[concat(variables('createdEventHubNamespace'), '/', variables('eventhubLogsName'))]",
      "apiVersion": "2017-04-01",
      "location": "[resourceGroup().location]",
      "properties": {
        "messageRetentionInDays": 1,
        "partitionCount": 1,
        "status": "Active"
      },
      "dependsOn": [
        "[resourceId('Microsoft.EventHub/namespaces', variables('createdEventHubNamespace'))]"
      ]
    },
    {
      "condition": "[variables('createEventHubResources')]",
      "type": "Microsoft.EventHub/namespaces/eventhubs/authorizationRules",
      "apiVersion": "2017-04-01",
      "name": "[concat(variables('createdEventHubNamespace'), '/', variables('eventhubLogsName'),'/',variables('listener'))]",
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[resourceId('Microsoft.EventHub/namespaces/eventhubs', variables('createdEventHubNamespace'), variables('eventhubLogsName'))]",
        "[resourceId('Microsoft.EventHub/namespaces', variables('createdEventHubNamespace'))]"
      ],
      "properties": {
        "rights": [
          "Listen"
        ]
      }
    },
    {
      "condition": "[variables('createEventHubResources')]",
      "type": "Microsoft.EventHub/namespaces/eventhubs/authorizationRules",
      "apiVersion": "2017-04-01",
      "name": "[concat(variables('createdEventHubNamespace'), '/', variables('eventhubLogsName'),'/',variables('sender'))]",
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[resourceId('Microsoft.EventHub/namespaces/eventhubs', variables('createdEventHubNamespace'), variables('eventhubLogsName'))]",
        "[resourceId('Microsoft.EventHub/namespaces', variables('createdEventHubNamespace'))]"
      ],
      "properties": {
        "rights": [
          "Send"
        ]
      }
    },
    {
      "condition": "[variables('createCustomConsumerGroup')]",
      "type": "Microsoft.EventHub/namespaces/eventhubs/consumergroups",
      "name": "[concat(variables('createdEventHubNamespace'), '/', variables('eventhubLogsName'), '/', variables('ConsumergroupsLogsName'))]",
      "apiVersion": "2017-04-01",
      "location": "[resourceGroup().location]",
      "scale": null,
      "properties": {},
      "dependsOn": [
        "[resourceId('Microsoft.EventHub/namespaces', variables('createdEventHubNamespace'))]",
        "[resourceId('Microsoft.EventHub/namespaces/eventhubs', variables('createdEventHubNamespace'), variables('eventhubLogsName'))]"
      ]
    }
  ],
  "outputs": {
    "useExistingEventHub": {
      "type": "bool",
      "value": "[variables('useExistingEventHub')]"
    },
    "eventHubName": {
      "type": "string",
      "value": "[variables('eventhubLogsName')]"
    },
    "eventHubNamespace": {
      "type": "string",
      "value": "[variables('eventHubNamespaceName')]"
    },
    "eventHubResourceGroup": {
      "type": "string",
      "value": "[variables('eventHubResourceGroup')]"
    },
    "eventHubAuthorizationRuleId": {
      "type": "string",
      "value": "[variables('activeAuthRuleId')]"
    }
  }
}
